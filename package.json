{
  "name": "openboxgl-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-redirects.mjs && node scripts/generate-sitemap.mjs",
    "start": "next start",
    "lint": "eslint .",
    "docs:index": "node scripts/build-docs-index.mjs",
    "test": "node scripts/build-docs-index.mjs && next build && node scripts/generate-redirects.mjs && node scripts/generate-sitemap.mjs && node scripts/check-built-site.mjs",
    "serve": "node server/index.mjs",
    "serve:dev": "bun --watch server/index.mjs",
    "docker": "docker compose up --build"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.3.0",
    "next-mdx-remote-client": "^2.1.12",
    "react": "^19",
    "react-dom": "^19",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}