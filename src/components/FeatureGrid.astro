---
interface Item {
  href: string;
  title: string;
  description: string;
  eyebrow?: string;
}
interface Props {
  label?: string;
  items?: Item[];
}
const { label, items = [] } = Astro.props as Props;
---
<nav class="feature-grid" aria-label={label ?? 'OpenBoxGL guides'}>
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href}>
          {item.eyebrow && <span class="feature-grid__eyebrow">{item.eyebrow}</span>}
          <strong>{item.title}</strong>
          <span class="feature-grid__desc">{item.description}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
