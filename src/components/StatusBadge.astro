---
type Status = 'done' | 'partial' | 'missing';
interface Props {
  status?: Status;
}
const { status = 'done' } = Astro.props as { status?: Status };
const label: Record<Status, string> = {
  done: 'Done',
  partial: 'Partial',
  missing: 'Missing',
};
---
<span class={`status-badge status-${status}`}>{label[status]}</span>
